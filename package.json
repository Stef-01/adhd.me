{
  "name": "adhd-me",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:visual": "ADHDME_FIXED_CLOCK=2026-03-03T03:03:03.000Z playwright test e2e/support/visual-stability.spec.ts",
    "audit:gate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/audit-gate.mts",
    "generate:aesthetic-coverage": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-aesthetic-coverage.mts",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm audit:gate",
    "gate": "pnpm verify && pnpm e2e"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vercel/analytics": "^2.0.1",
    "docx": "^9.7.1",
    "motion": "^13.0.0",
    "next": "^15.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "adm-zip": "^0.6.0",
    "fast-check": "^4.9.0",
    "postcss": "^8.5.0",
    "pptxgenjs": "^4.0.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23",
      "sharp": ">=0.35.0"
    }
  }
}
