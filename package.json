    "@phosphor-icons/react": "^2.1.10",
    "docx": "^9.7.1",
    "motion": "^13.0.0",
    "next": "^15.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "adm-zip": "^0.6.0",
    "postcss": "^8.5.0",
    "pptxgenjs": "^4.0.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "overrides": {
