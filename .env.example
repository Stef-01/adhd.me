# ADHD.ME — every environment variable the tree reads, one line of purpose each.
#
# U2 (O228). `src/lib/env.test.ts` holds this file to the tree in both directions: a variable read
# anywhere in app/, src/, scripts/, e2e/ or the three root configs must be listed here, and a
# variable listed here must be read somewhere. Copy to `.env.local` for a local run; nothing
# below is required outside production, and no value here is a credential.

# --- Posture (read once by src/lib/env.ts; instrumentation.ts refuses to serve a production process that fails it) ---

# HMAC key for booking tokens and console sessions. Required by every production build; outside
# production a committed synthetic-phase fallback signs instead.
ADHDME_TOKEN_SECRET=

# "1" opens the /api/mock/* introspection routes on a production BUILD (the e2e suite does this).
# Refused on the production DEPLOYMENT: they disclose signed tokens and reset shared state.
ADHDME_ENABLE_MOCK_ROUTES=

# "1" opens /demo, the presenter's reset-and-sign-in surface, on a production build. Refused on the
# production deployment.
ADHDME_ENABLE_DEMO=

# Set by Vercel: "production", "preview" or "development". Only "production" is THE deployment;
# a local `next start` never has it, which is what lets the e2e run a production build with the
# mock routes on.
VERCEL_ENV=

# Set by Next during `next build` ("phase-production-build"); the posture assertion stands aside
# for the build and holds the server that serves it.
NEXT_PHASE=

# "production" for `next build` / `next start`, "development" under `next dev`, "test" under vitest.
NODE_ENV=

# --- Origin and public identity ---

# Absolute origin for canonical URLs, OG tags, robots and the sitemap. Overrides the Vercel
# hostname; when neither is set the local server (http://localhost:3000) is the origin.
NEXT_PUBLIC_SITE_URL=

# Set by Vercel on every build: the project's production hostname, used as the origin when
# NEXT_PUBLIC_SITE_URL is unset.
VERCEL_PROJECT_PRODUCTION_URL=

# Google Analytics measurement id. Unset means no analytics script is rendered and the
# report-only CSP names no Google host.
NEXT_PUBLIC_GA_ID=

# Set by Vercel when system envs are exposed: the commit the build came from, inlined into the
# voice debug banner so a stale deploy is visible.
NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA=

# --- Store files (synthetic phase; every store is a JSONL file under .data/ by default) ---

# Where the clinician onboarding store writes.
ADHDME_CLINICIAN_PATH=

# Where the clinician background-check store writes.
ADHDME_BACKGROUND_PATH=

# Where the interest register writes.
ADHDME_INTEREST_PATH=

# Where the outbound hand-off attribution store writes.
ADHDME_OUTBOUND_PATH=

# --- Test harness only ---

# ISO instant the server clock is pinned to for visual baselines; honoured only with the mock
# routes opted in.
ADHDME_FIXED_CLOCK=

# Port the e2e web server listens on (default 3100).
E2E_PORT=

# Path to a Chromium binary for Playwright when the default install is not present.
PW_CHROMIUM_PATH=

# Set on CI runners: forbids `test.only` and adds the HTML reporter.
CI=

# Any value rewrites the golden report fixtures instead of comparing against them.
UPDATE_GOLDEN=

# Visual stability mode: a directory to write captures to, comparing nothing.
VISUAL_RUN_OUT=
